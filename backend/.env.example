# Copy to backend/.env for local development. Everything is optional: with nothing set,
# FINN runs in zero-key, open, rules-only mode on the committed snapshot.

# Private access: open the app once at /?key=<this value>
# FINN_ACCESS_TOKEN=

# Optional model upgrade (any OpenAI-compatible endpoint; Gemini's by default)
# FINN_LLM_API_KEY=
# FINN_LLM_FAST=gemini-3.5-flash-lite
# FINN_LLM_DEEP=gemini-3.8-flash
# FINN_LLM_DEEP_TIMEOUT_S=25
# FINN_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Data
# FINN_DATA_DIR=./data
# FINN_LIVE_TTL_HOURS=20
